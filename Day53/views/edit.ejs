<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your chat</title>
</head>
<body>
    <h3>Edit your chat : <%= chat.id %></h3>
    <p>This chat was sent from <b><%= chat.from %></b> to <b><%= chat.to %></b></p>
    <form action="/chats/<%= chat._id %>?_method=PUT" method="POST">
        <textarea  name="message"><%= chat.message %></textarea>
        <br>

        <button type="submit">Update</button>
    </form>
</body>
</html>